<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jeanmachado.pythonsearch</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
        <string>daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- The daemon shells out to the PythonSearch console scripts, which live in a conda env that
         a LaunchAgent does not inherit. Recorded at install time. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PS_BIN_PATH</key>
        <string>__BIN_DIR__</string>
        <key>PATH</key>
        <string>__BIN_DIR__:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.python_search/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.python_search/daemon.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
